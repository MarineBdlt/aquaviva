# Copy to .env on the server (never commit real secrets).
SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_SECURE=true

# Gmail SMTP for /reserver contact form
# 1) Enable 2FA on the Gmail account that SENDS mail
# 2) Create an App Password: https://myaccount.google.com/apppasswords
# 3) Put that 16-char password below (not the normal Gmail password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=anais.acquaviva@gmail.com
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=anais.acquaviva@gmail.com
